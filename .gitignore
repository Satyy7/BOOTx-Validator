# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/
build/
dist/

# Firmware source trees (fetched by scripts, not vendored)
firmware/tf-a/src/
firmware/u-boot/src/
firmware/linux/src/

# Build outputs
firmware/tf-a/build/
firmware/u-boot/build/
firmware/linux/build/
qemu/images/

# Runtime artifacts
artifacts/*
!artifacts/.gitkeep
reports/runs/*
!reports/runs/.gitkeep

# Dashboard: node_modules/.next/tsbuildinfo/etc. are already covered by
# dashboard/.gitignore (generated by create-next-app), kept authoritative
# there rather than duplicated here.

# Editor / OS
.vscode/
.DS_Store
*.swp

# Claude Code tool-local state
.claude/
